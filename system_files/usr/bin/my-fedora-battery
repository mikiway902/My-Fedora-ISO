#!/bin/bash
# Apply ThinkPad battery charge thresholds.
#
# The thresholds live in /etc/my-fedora/battery.conf so they can be changed
# without rebuilding the image. sysfs files are optional: on a machine (or a
# firmware revision) that does not expose them this script only warns, so boot
# and resume never fail because of the battery.
set -euo pipefail

CONFIG=${MY_FEDORA_BATTERY_CONFIG:-/etc/my-fedora/battery.conf}
SYSFS=${MY_FEDORA_SYSFS_ROOT:-/sys}
DEFAULT_START=75
DEFAULT_END=80

die() {
    printf 'my-fedora-battery: %s\n' "$*" >&2
    exit 1
}

usage() {
    cat <<'EOF'
Usage: my-fedora-battery [show|apply|set --start N --end N|profile NAME]

  show                     show the configured and active thresholds
  apply                    write the configured thresholds to every battery
  set --start N --end N    change and persist the thresholds (root)
  profile NAME             use a preset (root):
                             main       75/80  everyday use
                             longevity  40/80  mostly plugged in
                             travel     95/100 charge fully before a trip
EOF
}

load_config() {
    CHARGE_START=$DEFAULT_START
    CHARGE_END=$DEFAULT_END
    if [[ -r $CONFIG ]]; then
        # shellcheck disable=SC1090
        source "$CONFIG"
    fi
    : "${CHARGE_START:=$DEFAULT_START}" "${CHARGE_END:=$DEFAULT_END}"
}

validate() {
    [[ $CHARGE_START =~ ^[0-9]{1,3}$ ]] || die "start threshold must be a number"
    [[ $CHARGE_END =~ ^[0-9]{1,3}$ ]] || die "end threshold must be a number"
    # 10# avoids treating a leading zero as octal
    CHARGE_START=$((10#$CHARGE_START))
    CHARGE_END=$((10#$CHARGE_END))
    (( CHARGE_START >= 0 && CHARGE_END <= 100 && CHARGE_START < CHARGE_END )) ||
        die "need 0 <= start < end <= 100 (got ${CHARGE_START}/${CHARGE_END})"
}

batteries() {
    local dir
    for dir in "$SYSFS"/class/power_supply/BAT*; do
        [[ -d $dir ]] && printf '%s\n' "$dir"
    done
    return 0
}

read_value() {
    if [[ -r $1 ]]; then
        tr -d '\n' <"$1" 2>/dev/null || true
    fi
}

write_value() {
    local file=$1 value=$2 label=$3
    if [[ -e $file ]]; then
        if printf '%s\n' "$value" >"$file" 2>/dev/null; then
            printf '%s: %s threshold = %s%%\n' "$(basename "$(dirname "$file")")" "$label" "$value"
        else
            printf 'warning: cannot write %s (run as root?)\n' "$file" >&2
        fi
    else
        printf 'note: %s is not exposed by this firmware/driver\n' "$file" >&2
    fi
}

apply_one() {
    local dir=$1 start_file end_file current_end
    start_file="$dir/charge_control_start_threshold"
    end_file="$dir/charge_control_end_threshold"
    current_end=$(read_value "$end_file")

    # The EC rejects start > end, so raise the ceiling before the floor
    # (e.g. going from 75/80 to the 95/100 travel preset) and lower the floor
    # first when going the other way.
    if [[ -n $current_end && $current_end =~ ^[0-9]+$ ]] && (( CHARGE_START > 10#$current_end )); then
        write_value "$end_file" "$CHARGE_END" end
        write_value "$start_file" "$CHARGE_START" start
    else
        write_value "$start_file" "$CHARGE_START" start
        write_value "$end_file" "$CHARGE_END" end
    fi
}

apply_thresholds() {
    load_config
    validate

    local found=0 dir
    for dir in $(batteries); do
        found=1
        apply_one "$dir"
    done
    if ((found == 0)); then
        printf 'note: no battery found under %s/class/power_supply\n' "$SYSFS" >&2
    fi
}

show_thresholds() {
    load_config
    validate

    printf 'config: %s\n' "$CONFIG"
    printf 'configured: start %s%%, end %s%%\n' "$CHARGE_START" "$CHARGE_END"

    local found=0 dir
    for dir in $(batteries); do
        found=1
        printf '\n%s\n' "$(basename "$dir")"
        printf '  manufacturer: %s\n' "$(read_value "$dir/manufacturer")"
        printf '  model:        %s\n' "$(read_value "$dir/model_name")"
        printf '  status:       %s\n' "$(read_value "$dir/status")"
        printf '  capacity:     %s%%\n' "$(read_value "$dir/capacity")"
        printf '  cycle count:  %s\n' "$(read_value "$dir/cycle_count")"
        printf '  start:        %s%%\n' "$(read_value "$dir/charge_control_start_threshold")"
        printf '  end:          %s%%\n' "$(read_value "$dir/charge_control_end_threshold")"
    done
    if ((found == 0)); then
        printf 'note: no battery found under %s/class/power_supply\n' "$SYSFS" >&2
    fi
}

save_config() {
    local config_dir tmp
    config_dir=$(dirname "$CONFIG")
    [[ -d $config_dir ]] || mkdir -p "$config_dir" ||
        die "cannot create $config_dir"
    [[ -w $config_dir ]] || die "cannot write $config_dir (run as root)"

    tmp=$(mktemp "$CONFIG.XXXXXX") || die "cannot create a temporary file"
    {
        printf '%s\n' \
            '# ThinkPad charge thresholds in percent (thinkpad_acpi).' \
            '# start = resume charging below this level, end = stop charging at this level.' \
            '# Change with: sudo my-fedora-battery profile main|longevity|travel' \
            '#              sudo my-fedora-battery set --start N --end N'
        printf 'CHARGE_START=%s\n' "$CHARGE_START"
        printf 'CHARGE_END=%s\n' "$CHARGE_END"
    } >"$tmp"
    chmod 0644 "$tmp"
    mv -f "$tmp" "$CONFIG"
    printf 'saved %s (start %s%%, end %s%%)\n' "$CONFIG" "$CHARGE_START" "$CHARGE_END"
}

set_thresholds() {
    local start="" end=""
    while (($#)); do
        case $1 in
            --start) start=${2:?--start needs a value}; shift 2 ;;
            --end) end=${2:?--end needs a value}; shift 2 ;;
            --help | -h) usage; exit 0 ;;
            *) die "unknown option: $1" ;;
        esac
    done
    [[ -n $start && -n $end ]] || die "set needs --start and --end"
    CHARGE_START=$start
    CHARGE_END=$end
    validate
    save_config
    apply_thresholds
}

use_profile() {
    case ${1:-} in
        main | 75/80)
            CHARGE_START=75
            CHARGE_END=80
            ;;
        longevity | 40/80)
            CHARGE_START=40
            CHARGE_END=80
            ;;
        travel | 95/100)
            CHARGE_START=95
            CHARGE_END=100
            ;;
        *)
            usage
            exit 2
            ;;
    esac
    validate
    save_config
    apply_thresholds
}

case ${1:-show} in
    show) show_thresholds ;;
    apply) apply_thresholds ;;
    set)
        shift
        set_thresholds "$@"
        ;;
    profile) use_profile "${2:-}" ;;
    --help | -h) usage ;;
    *)
        usage
        exit 2
        ;;
esac
